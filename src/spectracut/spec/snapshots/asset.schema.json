{
  "$defs": {
    "LicenseRecord": {
      "additionalProperties": false,
      "description": "Per asset: source, licence and whether it is commercial-safe.",
      "properties": {
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "commercial_safe": {
          "title": "Commercial Safe",
          "type": "boolean"
        },
        "licence": {
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "non_commercial": {
          "default": false,
          "title": "Non Commercial",
          "type": "boolean"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source",
        "licence",
        "commercial_safe"
      ],
      "title": "LicenseRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Modeled object, material, rig, Look, sound or effect; versioned and reusable.",
  "properties": {
    "dirty": {
      "default": false,
      "title": "Dirty",
      "type": "boolean"
    },
    "file_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Ref"
    },
    "id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "model",
        "material",
        "rig",
        "look",
        "sound",
        "effect"
      ],
      "title": "Kind",
      "type": "string"
    },
    "license": {
      "$ref": "#/$defs/LicenseRecord"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "recipe_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recipe Ref"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "license"
  ],
  "title": "Asset",
  "type": "object"
}
